{
  "name": "vors-cleaning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "models": "node scripts/build-models.mjs && node scripts/optimize-models.mjs",
    "icons": "node scripts/build-icons.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "motion": "14.14.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.187.0",
    "embedded-postgres": "18.6.0-beta.19",
    "meshoptimizer": "0.25.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true
  }
}
